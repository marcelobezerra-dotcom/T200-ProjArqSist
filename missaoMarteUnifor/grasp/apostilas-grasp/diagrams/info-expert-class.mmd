classDiagram
    class ElementoMapa {
        <<abstract>>
        -int x
        -int y
        +ocupa(x, y) boolean
        +mesmaPosicao(outro) boolean
    }
    class Nave {
        -int capacidade
        -List~Passageiro~ passageiros
        +embarcar(passageiro) boolean
    }
    class Passageiro {
        <<abstract>>
        +getPontuacao()* int
    }
    class Missao {
        +passagemNaPosicao() Passageiro
        +embarcarPassageiroNaPosicao() boolean
        +verificaColisao() boolean
    }
    ElementoMapa <|-- Nave
    ElementoMapa <|-- Passageiro
    Missao --> Nave
    Missao --> "*" Passageiro
    Nave --> "*" Passageiro : a bordo
