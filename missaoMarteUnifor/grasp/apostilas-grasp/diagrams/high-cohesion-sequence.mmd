sequenceDiagram
    participant GameController
    participant JogoService
    participant Nave
    participant Missao
    participant Perigo
    GameController->>JogoService: executar(DIREITA)
    JogoService->>Nave: mover(DIREITA, minX, maxX, minY, maxY)
    Nave-->>JogoService: true
    JogoService->>JogoService: descontar ponto e contar movimento
    JogoService->>Missao: atualizarPerigos(random, minX, maxX, minY, maxY)
    loop cada perigo
        Missao->>Perigo: atualizar(random, minX, maxX, minY, maxY)
    end
    JogoService->>Missao: verificaColisao()
    Missao-->>JogoService: colisão
    opt houve colisão
        JogoService->>Nave: perderVida()
    end
    JogoService->>JogoService: verificar vidas, pontos e objetivo
    JogoService-->>GameController: EventoJogo
